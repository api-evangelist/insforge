        {
          "id": "1fa8c5b2-7657-4495-b130-6afec228fd45",
          "name": "Revoke S3 Access Key",
          "request": {
            "name": "Revoke S3 Access Key",
            "description": {
              "content": "Revoke an S3 access key by its id. The in-memory LRU cache is\ninvalidated synchronously so subsequent S3 protocol requests with\nthis credential return `403 InvalidAccessKeyId`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "storage",
                "s3",
                "access-keys",
                ":id"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "id",
                  "description": "(Required) UUID of the access key to revoke (from the create/list response)"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "DELETE"
