                    {
                      "name": "Create S3 Access Key",
                      "id": "59fa535f-2720-4995-b83e-7de7ce862d76",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "auth": {
                          "type": "apikey",
                          "apikey": [
                            {
                              "key": "key",
                              "value": "x-api-key",
                              "type": "string"
                            },
                            {
                              "key": "value",
                              "value": "{{apiKey}}",
                              "type": "string"
                            },
                            {
                              "key": "in",
                              "value": "header",
                              "type": "string"
                            }
                          ]
                        },
                        "method": "POST",
                        "header": [
                          {
                            "key": "Content-Type",
                            "value": "application/json"
                          },
                          {
                            "key": "Accept",
                            "value": "application/json"
                          }
                        ],
                        "body": {
                          "mode": "raw",
                          "raw": "{\n  \"description\": \"<string>\"\n}",
                          "options": {
                            "raw": {
                              "headerFamily": "json",
                              "language": "json"
                            }
                          }
                        },
                        "url": {
                          "raw": "{{baseUrl}}/api/storage/s3/access-keys",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            "api",
                            "storage",
                            "s3",
                            "access-keys"
                          ]
                        },
                        "description": "Mint a new S3 credential pair usable against the `/storage/v1/s3`\nprotocol gateway. The plaintext `secretAccessKey` in the response\nis returned **exactly once** \u2014 it is encrypted at rest and can\nnever be retrieved again. If you lose it, revoke and re-create.\n\nLimits:\n- 50 keys per project (hard cap, enforced transactionally).\n- Rate-limited to 20 management requests per 15 min per IP."
                      },
                      "response": [
                        {
                          "id": "81f55eeb-e2c4-4b29-a7a0-4ce6a3dc45ae",
                          "name": "Access key created",
                          "originalRequest": {
                            "method": "POST",
                            "header": [
                              {
                                "key": "Content-Type",
                                "value": "application/json"
                              },
                              {
                                "key": "Accept",
                                "value": "application/json"
                              },
                              {
                                "description": "Added as a part of security scheme: apikey",
