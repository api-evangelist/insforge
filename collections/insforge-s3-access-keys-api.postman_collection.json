          "id": "c87cd201-93fb-4da3-8fac-d50ded5602aa",
          "name": "Get S3 Gateway Config",
          "request": {
            "name": "Get S3 Gateway Config",
            "description": {
              "content": "Return the externally-reachable endpoint URL and the SigV4 signing\nregion for the S3 protocol gateway. The endpoint is assembled from\nthe server's `VITE_API_BASE_URL` env var plus `/storage/v1/s3`, and\nthe region is `AWS_REGION` (default `us-east-2`).\n\nIntended for Dashboard display so the UI doesn't make any\nbackend-topology assumptions client-side.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "storage",
                "s3",
                "config"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET"
