        {
          "id": "9abe8ee7-9f21-41ce-b68a-23821539ea23",
          "name": "Create S3 Access Key",
          "request": {
            "name": "Create S3 Access Key",
            "description": {
              "content": "Mint a new S3 credential pair usable against the `/storage/v1/s3`\nprotocol gateway. The plaintext `secretAccessKey` in the response\nis returned **exactly once** — it is encrypted at rest and can\nnever be retrieved again. If you lose it, revoke and re-create.\n\nLimits:\n- 50 keys per project (hard cap, enforced transactionally).\n- Rate-limited to 20 management requests per 15 min per IP.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "storage",
                "s3",
                "access-keys"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
