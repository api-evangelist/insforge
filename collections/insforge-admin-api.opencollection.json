  },
  "items": [
    {
      "info": {
        "name": "Admin",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get all available AI models",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ai/models",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the normalized OpenRouter model catalog fetched from OpenRouter with output_modalities=all."
        },
        {
          "info": {
            "name": "Get Model Gateway overview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ai/overview",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns key-level OpenRouter usage and activity time series when the key has activity access."
        },
        {
          "info": {
            "name": "Get active provider API key",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/ai/:provider/api-key",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path",
                "description": "AI provider identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the active provider API key details for admin copy workflows. Currently only `openrouter` is supported."
        },
        {
          "info": {
            "name": "Rotate provider API key",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/ai/:provider/api-key/rotate",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path",
                "description": "AI provider identifier"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Rotate the active provider API key for cloud-managed Model Gateway credentials. Currently only `openrouter` is supported."
        },
        {
          "info": {
            "name": "Get authentication configuration",
