        {
          "info": {
            "name": "Get specific user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/users/:userId",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "User ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Get user details by ID (admin only)"
        },
        {
          "info": {
            "name": "Admin login",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/admin/sessions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates admin user for dashboard access"
        },
        {
          "info": {
            "name": "Exchange cloud provider authorization code for admin session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/admin/sessions/exchange",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Verifies an authorization code/JWT from from Insforge Cloud platform and issues an internal admin session token with project_admin role"
        },
        {
          "info": {
            "name": "Refresh admin dashboard access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/admin/refresh",
            "headers": [
              {
                "name": "X-CSRF-Token",
                "value": ""
              }
            ]
          },
          "docs": "Uses the dashboard-only httpOnly `insforge_admin_refresh_token` cookie with an `X-CSRF-Token` header."
        },
        {
          "info": {
            "name": "Logout admin dashboard session",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/admin/logout",
            "headers": [
              {
                "name": "X-CSRF-Token",
                "value": ""
              }
            ]
          },
          "docs": "Clears the dashboard-only `insforge_admin_refresh_token` cookie.\n\nIf a valid admin refresh cookie is present, the request must include the `X-CSRF-Token`\nheader returned from admin login, admin session exchange, or admin refresh. Missing, expired,\ninvalid, or wrong-session-type admin refresh cookies are cleared idempotently and still return\nsuccess.\n"
        },
        {
          "info": {
            "name": "Get anon key (deprecated)",
            "type": "http"
