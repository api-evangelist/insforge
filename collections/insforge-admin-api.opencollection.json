            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns paginated list of users"
        },
        {
          "info": {
            "name": "Delete users (admin only)",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
