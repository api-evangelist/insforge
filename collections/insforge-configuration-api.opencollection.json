{
  "opencollection": "1.0.0",
  "info": {
    "name": "Insforge AI Admin Configuration API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Realtime Config",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/api/realtime/config",
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieve realtime message retention configuration"
        },
        {
          "info": {
            "name": "Update Realtime Config",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/realtime/config",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Update realtime message retention configuration"
        }
      ]
    }
  ],
  "bundled": true
}